# --- Base de datos ---
DATABASE_URL=postgres://picbook:picbook_pass_change_me@db:5432/picbook

# --- Sesión ---
# Genera uno propio y largo, por ejemplo con: openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-en-produccion

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Fotos ---
# Debe apuntar a un volumen persistente montado en el contenedor
UPLOAD_DIR=/data/uploads

# --- Login con Google (opcional) ---
# Se obtienen en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://tu-dominio.com/api/auth/google/callback
